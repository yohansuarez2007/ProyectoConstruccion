# Copiar a .env. Nunca subir .env a Git.
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
# Copiar URI de Supabase > Connect (Direct o Session Pooler).
# Si contraseña incluye @, #, : o /, codificarla en la URL.
DATABASE_URL=postgresql://USUARIO:CLAVE@HOST:5432/postgres
PGSSL=true
PGSSL_CA_PATH=./certs/supabase-ca.crt
PGPOOL_MAX=5
LAB_DIAGNOSTICS_ENABLED=true
# Generar un token aleatorio largo; minimo 32 caracteres
LAB_DIAGNOSTICS_TOKEN=REEMPLAZAR_CON_TOKEN_ALEATORIO_DE_32_O_MAS_CARACTERES
